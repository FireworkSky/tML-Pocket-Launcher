{
  "name": "tml-pocket-launcher-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8769 --strictPort",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src *.json *.ts *.html README.md public/preview.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8768 --strictPort",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.5",
    "motion": "14.14.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.1.0",
    "patch-package": "^8.0.1",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
